<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Dwemer_Hall_Kin</defName>
        <label>hall kin</label>
        <description>A recognized member of the clan with a seat at the long table and a duty to answer questions about their work.</description>
        <tags>
            <li>ESCP_Title_Dwemer</li>
        </tags>
        <seniority>0</seniority>
        <favorCost>1</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>False</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>1</permitPointsAwarded>
    </RoyalTitleDef>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Dwemer_Journeyman</defName>
        <label>journeyman</label>
        <description>A craftsperson whose work has passed a master's measuring tools. It is a surprisingly hard thing to achieve.</description>
        <tags>
            <li>ESCP_Title_Dwemer</li>
        </tags>
        <seniority>200</seniority>
        <favorCost>6</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>True</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>2</permitPointsAwarded>
    </RoyalTitleDef>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Dwemer_Tonal</defName>
        <label>tonal architect</label>
        <description>A master of tonal theory. Architects are the closest thing the Dwemer have to a priesthood, and would be appalled to hear it.</description>
        <tags>
            <li>ESCP_Title_Dwemer</li>
        </tags>
        <seniority>500</seniority>
        <favorCost>10</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>True</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>3</permitPointsAwarded>
    </RoyalTitleDef>

    <RoyalTitleDef ParentName="ESCP_Base_Empire_Titles" MayRequire="Ludeon.RimWorld.Royalty">
        <defName>ESCP_Title_Dwemer_Craft_Lord</defName>
        <label>craft lord</label>
        <description>Holder of a whole trade's authority within the clan, with the right to overrule anyone on questions of method.</description>
        <tags>
            <li>ESCP_Title_Dwemer</li>
        </tags>
        <seniority>900</seniority>
        <favorCost>16</favorCost>
        <changeHeirQuestPoints>1000</changeHeirQuestPoints>
        <commonality>1</commonality>
        <allowDignifiedMeditationFocus>True</allowDignifiedMeditationFocus>
        <awardWorkerClass>RoyalTitleAwardWorker_Instant</awardWorkerClass>
        <permitPointsAwarded>4</permitPointsAwarded>
    </RoyalTitleDef>

</Defs>
