<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <TraderKindDef>
        <defName>ESCP_Caravan_Dwemer_Trader</defName>
        <label>Dwemer trader</label>
        <modExtensions>
            <li Class="ESCP.Currencies.CurrencyReplacement">
                <currency>ESCP_Currency_Septims</currency>
            </li>
        </modExtensions>

        <stockGenerators>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Steel</thingDef>
                <countRange>200~500</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Plasteel</thingDef>
                <countRange>15~50</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>ComponentIndustrial</thingDef>
                <countRange>12~40</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Silver</thingDef>
                <countRange>300~800</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Gold</thingDef>
                <countRange>10~40</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>Pemmican</thingDef>
                <countRange>60~120</countRange>
            </li>

            <li Class="StockGenerator_SingleDef">
                <thingDef>ESCP_Tome_Telekinesis</thingDef>
                <countRange>1~1</countRange>
            </li>

            <li Class="StockGenerator_BuyTradeTag">
                <tag>Art</tag>
            </li>

            <li Class="StockGenerator_BuyTradeTag">
                <tag>ExoticMisc</tag>
            </li>
            <li Class="StockGenerator_Category">
                <categoryDef>ESCP_Resources_Raw</categoryDef>
                <thingDefCountRange>2~4</thingDefCountRange>
                <totalPriceRange>150~500</totalPriceRange>
            </li>
            <li Class="StockGenerator_Tag">
                <tradeTag>ESCP_ElementalSalts</tradeTag>
                <thingDefCountRange>1~2</thingDefCountRange>
                <countRange>4~12</countRange>
            </li>
            <li Class="StockGenerator_BuyTradeTag">
                <tag>ESCP_Bullion</tag>
            </li>

        </stockGenerators>

        <tradeCurrency>Silver</tradeCurrency>

    </TraderKindDef>

</Defs>
